rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /collections/{collectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read, write: if isAdmin();
      match /events/{eventId} {
        allow read: if isAdmin();
        allow create: if isAdmin();
      }
    }

    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update: if isAdmin();
    }

    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow read, write: if isAdmin();
      match /messages/{messageId} {
        allow read, write: if isAdmin();
      }
    }

    match /webhookEvents/{eventId} {
      allow read, write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }

    match /adminUsers/{userId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /feedbackSubmissions/{feedbackId} {
      // Anyone can create feedback (public form)
      allow create: if true
        && request.resource.data.keys().hasOnly([
          'publicReference', 'type', 'category', 'title', 'message',
          'rating', 'relatedProductId', 'relatedProductSnapshot',
          'suggestedItems', 'occasion', 'budgetRange', 'quantityRange',
          'companyName', 'contactName', 'email', 'phone',
          'anonymous', 'contactRequested', 'consent',
          'status', 'priority', 'sentiment', 'tags',
          'source', 'idempotencyKeyHash', 'isDemoData',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.status == 'new'
        && request.resource.data.priority == 'normal'
        && request.resource.data.sentiment == 'not_classified';

      // Only admin can read, update, or delete
      allow read, update, delete: if isAdmin();

      // Immutable events subcollection
      match /events/{eventId} {
        allow read: if isAdmin();
        allow create: if isAdmin();
        // No update or delete — events are immutable
      }
    }

    match /recommendationRequests/{requestId} {
      // Anyone can create
      allow create: if true
        && request.resource.data.status == 'new'
        && request.resource.data.priority == 'normal'
        && request.resource.data.consent == true;

      allow read, update, delete: if isAdmin();

      match /events/{eventId} {
        allow read: if isAdmin();
        allow create: if isAdmin();
      }
    }

    match /feedbackAggregates/{aggregateId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /feedbackSettings/{settingId} {
      allow read, write: if isAdmin();
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
  }
}
